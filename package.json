{
  "name": "foreman-solo",
  "version": "0.1.0",
  "description": "Code review and health scanning CLI for freelance Node developers: findings, a 0-100 health score, a go-live checklist and a static report.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "foreman-solo": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check:pack": "node scripts/check-pack.mjs",
    "check": "npm run lint && npm test && npm run build && node dist/bin.js scan . --no-audit --no-history && npm run check:pack && npm audit --omit=dev --audit-level=high",
    "hooks": "git config core.hooksPath .githooks",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "security",
    "code-review",
    "static-analysis",
    "express",
    "freelance",
    "cli"
  ],
  "dependencies": {
    "commander": "^15.1.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "vitest": "^5.1.0"
  }
}
