{
  "name": "foreman-solo",
  "version": "0.1.0",
  "description": "Code review and health scanning CLI for freelance Node developers: findings, a 0-100 health score, a go-live checklist and a static report.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "foreman-solo": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "security",
    "code-review",
    "static-analysis",
    "express",
    "freelance",
    "cli"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "vitest": "^5.1.0"
  }
}
